{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sync-reader",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-11",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "sync-reader"
    }
  ],
  "triggers": {
    "crons": [
      "0 0 * * *"
    ]
  }
}
